# PayPal REST API credentials (developer.paypal.com → Apps & Credentials).
# Without these the checkout button lands on /checkout/demo, which explains
# that payments aren't connected yet instead of failing quietly.
#
# This is a separate thing from a PayPal.com pay link — a pay link is one
# fixed price, and these credentials are what let the server create a
# PayPal order for each basket's own total and charge that automatically.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" while testing with a PayPal developer sandbox account; unset (or
# "live") to take real payments through the production PayPal API.
PAYPAL_ENV=
